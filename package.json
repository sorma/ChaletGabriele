{
  "name": "chaletgabriele",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm test && npm run build",
    "release:check": "node scripts/check-release.mjs",
    "build:worker": "opennextjs-cloudflare build",
    "deploy": "npm run release:check && npm run lint && npm test && npm run build:worker && npm run db:check -- --remote && opennextjs-cloudflare deploy",
    "upload": "npm run release:check && npm run lint && npm test && npm run build:worker && npm run db:check -- --remote && opennextjs-cloudflare upload",
    "preview": "npm run build:worker && opennextjs-cloudflare preview",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:check": "node scripts/db-migrate.mjs --check",
    "db:seed": "node scripts/db-migrate.mjs --seed"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.7",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.8",
    "wrangler": "4.145.0"
  },
  "engines": { "node": ">=22.17.0" }
}
